# CanteenX web configuration. Copy to .env.
#
# Only values that are safe in a browser bundle belong here - everything in a
# VITE_* variable ships to the client.

# Leave EMPTY in development. The Vite dev server proxies /api, so the browser
# sees a single origin; cross-origin auth cookies would otherwise need
# SameSite=None, which needs HTTPS. Set this to the API's URL in production.
VITE_API_URL=

# Where the dev proxy forwards /api and the subscription WebSocket.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# GraphQL path, relative to VITE_API_URL.
VITE_GRAPHQL_ENDPOINT=/api/graphql

# Publishable key id only. The Razorpay secret must never appear here.
VITE_RAZORPAY_KEY_ID=

# Schema source for `npm run codegen`. Requires the API to be running.
VITE_CODEGEN_SCHEMA=http://127.0.0.1:8000/api/graphql
