# CanteenX API configuration.
# Copy to .env and fill in. See DEVDOC.md for the full table.
#
# There are no fallback values for secrets: a missing or weak JWT_SECRET raises
# on startup rather than signing tokens with something committed to the repo.

# --- Required ---------------------------------------------------------------
# Any Postgres URL. Normalised to asyncpg automatically, and ?sslmode= is
# translated for you (asyncpg rejects libpq's spelling).
DATABASE_URL=postgresql://canteenx:canteenx@localhost:55432/canteenx

# 32+ characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Runtime ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated. Required in production, where "*" is rejected because
# credentials are allowed.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Sessions ---------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# `none` requires HTTPS and is only accepted when ENVIRONMENT=production.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# --- CAS single sign-on -----------------------------------------------------
CAS_ENABLED=true
CAS_SERVER_URL=https://login.iiit.ac.in/cas/
CAS_SERVICE_URL=http://localhost:8080/cas
CAS_EMAIL_DOMAIN=iiit.ac.in

# --- Razorpay ---------------------------------------------------------------
# Leave blank to disable online payment. It is never mocked: absent keys
# produce a clear "not configured" error instead of approving everything.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A DIFFERENT secret from the API key above. Required for webhooks.
RAZORPAY_WEBHOOK_SECRET=

# --- Object storage ---------------------------------------------------------
# Leave blank to disable uploads. The key stays server-side; the API proxies.
# Uploads and reads are served by DIFFERENT hosts, and the upload response's
# own `url` field points at the wrong one - the public host always comes from
# here. Same workaround as the portfolio and workos projects.
ORACLE_UPLOAD_BASE_URL=https://supabase.dileepadari.dev
ORACLE_UPLOAD_PATH=/functions/v1/upload
ORACLE_PUBLIC_BASE_URL=https://mystorage.dileepadari.dev
ORACLE_UPLOAD_API_KEY=
ORACLE_APP_NAME=canteenx
# The box writes everything under one folder whatever x-file-type says.
ORACLE_STORAGE_FOLDER=images
UPLOAD_MAX_BYTES=8388608

# --- Real-time --------------------------------------------------------------
# Unset uses in-process pub/sub, correct for a single instance. Set this when
# running more than one, or events only reach the publishing instance.
# REDIS_URL=redis://localhost:6379/0

# --- Business rules ---------------------------------------------------------
TAX_RATE_BPS=500
ORDER_CANCELLATION_WINDOW_SECONDS=300
STOCK_RESERVATION_TTL_SECONDS=900

# --- Seeding ----------------------------------------------------------------
# Override before any deployment.
SEED_PASSWORD=canteenx-dev-2026
